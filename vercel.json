{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "node -e \"process.exit(/(^deploy:|\\[deploy\\]|\\(deploy\\):)/i.test(process.env.VERCEL_GIT_COMMIT_MESSAGE||'')?1:0)\"",
  "github": {
    "autoJobCancelation": true
  },
  "functions": {
    "api/live.js": {
      "memory": 3009,
      "maxDuration": 60
    },
    "api/historical-shard-migrate.js": {
      "maxDuration": 300
    },
    "api/historical-walk-forward.js": {
      "memory": 3009,
      "maxDuration": 300
    },
    "api/autonomous-supervisor.js": {
      "maxDuration": 120
    }
  }
}
