{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "node -e \"process.exit(process.env.VERCEL_GIT_COMMIT_REF==='main'||/^(deploy:|\\[deploy\\]|\\(deploy\\):)/i.test(process.env.VERCEL_GIT_COMMIT_MESSAGE||'')?1:0)\"",
  "github": {
    "autoJobCancelation": true
  },
  "crons": [
    {
      "path": "/api/autonomous-supervisor",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/site-self-test",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/deployment-verifier",
      "schedule": "6,21,36,51 * * * *"
    },
    {
      "path": "/api/historical-recent-backfill",
      "schedule": "31 2 * * *"
    },
    {
      "path": "/api/streak-intelligence",
      "schedule": "47 2 * * *"
    },
    {
      "path": "/api/fast-cycle",
      "schedule": "2-57/5 * * * *"
    },
    {
      "path": "/api/autopilot",
      "schedule": "3-58/5 * * * *"
    },
    {
      "path": "/api/training-bets-cron",
      "schedule": "4-59/5 * * * *"
    }
  ],
  "functions": {
    "api/live.js": {
      "maxDuration": 60
    },
    "api/historical-shard-migrate.js": {
      "maxDuration": 300
    },
    "api/historical-walk-forward.js": {
      "maxDuration": 300
    },
    "api/historical-recent-backfill.js": {
      "maxDuration": 120
    },
    "api/streak-intelligence.js": {
      "maxDuration": 120
    },
    "api/autonomous-supervisor.js": {
      "maxDuration": 120
    },
    "api/fast-cycle.js": {
      "maxDuration": 120
    },
    "api/deployment-verifier.js": {
      "maxDuration": 60
    }
  }
}
