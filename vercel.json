{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "node scripts/vercel-ignore-build.cjs",
  "github": {
    "autoJobCancelation": true
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/mobile-scan-fix.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/src/providers.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/autonomous-supervisor",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/site-self-test",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/deployment-verifier",
      "schedule": "17 */6 * * *"
    },
    {
      "path": "/api/historical-recent-backfill",
      "schedule": "31 2 * * *"
    },
    {
      "path": "/api/streak-intelligence",
      "schedule": "47 2 * * *"
    },
    {
      "path": "/api/shadow-settlement-cron",
      "schedule": "23 8 * * *"
    },
    {
      "path": "/api/fast-cycle",
      "schedule": "2-57/15 * * * *"
    },
    {
      "path": "/api/autopilot",
      "schedule": "5-50/15 * * * *"
    },
    {
      "path": "/api/training-bets-cron",
      "schedule": "8-53/15 * * * *"
    }
  ],
  "functions": {
    "api/live.js": {
      "maxDuration": 60
    },
    "api/historical-shard-migrate.js": {
      "maxDuration": 300
    },
    "api/historical-walk-forward.js": {
      "maxDuration": 300
    },
    "api/historical-recent-backfill.js": {
      "maxDuration": 120
    },
    "api/streak-intelligence.js": {
      "maxDuration": 120
    },
    "api/autonomous-supervisor.js": {
      "maxDuration": 120
    },
    "api/fast-cycle.js": {
      "maxDuration": 120
    },
    "api/deployment-verifier.js": {
      "maxDuration": 60
    },
    "api/shadow-settlement-cron.js": {
      "maxDuration": 60
    }
  }
}
