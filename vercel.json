{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "node -e \"const ref=process.env.VERCEL_GIT_COMMIT_REF||'';const env=process.env.VERCEL_ENV||'';const msg=process.env.VERCEL_GIT_COMMIT_MESSAGE||'';const force=/(^deploy:|\\[deploy\\]|\\(deploy\\):)/i.test(msg);process.exit(env==='production'||ref==='main'||force?1:0)\"",
  "github": {
    "autoJobCancelation": true
  },
  "crons": [
    {
      "path": "/api/autonomous-supervisor",
      "schedule": "*/10 * * * *"
    }
  ],
  "functions": {
    "api/live.js": {
      "maxDuration": 60
    },
    "api/historical-shard-migrate.js": {
      "maxDuration": 300
    },
    "api/historical-walk-forward.js": {
      "maxDuration": 300
    },
    "api/autonomous-supervisor.js": {
      "maxDuration": 120
    }
  }
}
