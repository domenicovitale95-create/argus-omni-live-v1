# Core football data
API_FOOTBALL_KEY=replace_with_your_api_sports_key

# Vercel cron authentication (recommended)
CRON_SECRET=replace_with_long_random_secret

# Persistent ARGUS memory / reports
# Vercel Blob is typically provisioned by Vercel; use the store credentials provided by the project.
BLOB_READ_WRITE_TOKEN=replace_if_using_legacy_blob_token
BLOB_STORE_ID=replace_if_required_by_your_blob_setup

# ARGUS Cognitive Core — OpenAI only
# OFF by default: no LLM call and no LLM inference cost until explicitly enabled.
COGNITIVE_LLM_ENABLED=false
COGNITIVE_OPENAI_MODEL=openai/gpt-5.6-sol
COGNITIVE_LLM_DAILY_MAX=4
COGNITIVE_LLM_COOLDOWN_HOURS=6
# On Vercel, AI Gateway may authenticate through VERCEL_OIDC_TOKEN automatically.
# AI_GATEWAY_API_KEY=replace_only_if_you_choose_api_key_auth

# Web Push / PWA alerts
VAPID_PUBLIC_KEY=replace_with_public_vapid_key
VAPID_PRIVATE_KEY=replace_with_private_vapid_key
VAPID_SUBJECT=mailto:your-alert-admin@example.com

# Email alerts (Resend)
RESEND_API_KEY=replace_with_resend_api_key
ARGUS_ALERT_FROM=ARGUS OMNI <alerts@your-verified-domain.com>
ARGUS_ALERT_EMAILS=domenicovitale95@gmail.com,sebastien.loncin@outlook.com
